{
  "allowManagedHooksOnly": true,
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "\"{{python}}\" -I -m doctrine hook session-start", "timeout": 30}]}
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "\"{{python}}\" -I -m doctrine hook pre-tool-use", "timeout": 30}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "\"{{python}}\" -I -m doctrine hook post-tool-use", "timeout": 60}]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "\"{{python}}\" -I -m doctrine hook stop", "timeout": 30},
          {"type": "command", "command": "node C:/Users/Omar/.claude/hooks/voice-notify.mjs", "timeout": 20}
        ]
      }
    ]
  }
}
